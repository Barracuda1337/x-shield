{
  "manifest_version": 3,
  "name": "X-Shield — Twitter & X Phishing Link Engelleyici",
  "version": "1.0.0",
  "description": "X (Twitter) altındaki cdn.eunwo, videy.rest gibi phishing, sahte .mp4 ve spam bot linklerini anında engeller ve gizler.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "X-Shield — Spam & Phishing Koruması"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "file://*/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "commands": {
    "toggle-shield": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "X-Shield korumasını aç / kapat"
    }
  }
}
